{
  "name": "schoolos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "compile:artifacts": "node scripts/compile-artifacts.mjs",
    "dev": "pnpm compile:artifacts && pnpm check:core-imports && pnpm --filter @schoolos/core build && pnpm check:core-dist && pnpm --parallel --filter @schoolos/api --filter @schoolos/web dev",
    "build": "pnpm compile:artifacts && pnpm check:core-imports && pnpm --filter @schoolos/core build && pnpm check:core-dist && pnpm --filter @schoolos/api build && pnpm --filter @schoolos/web build",
    "lint": "pnpm compile:artifacts && pnpm check:core-imports && pnpm --filter @schoolos/api format:check && pnpm --filter @schoolos/web lint",
    "typecheck": "pnpm compile:artifacts && pnpm check:core-imports && pnpm --filter @schoolos/core typecheck && pnpm --filter @schoolos/core build && pnpm check:core-dist && pnpm --filter @schoolos/api typecheck && pnpm --filter @schoolos/web typecheck",
    "test": "pnpm compile:artifacts && pnpm check:core-imports && pnpm --filter @schoolos/api test && pnpm --filter @schoolos/web test",
    "test:e2e": "pnpm --filter @schoolos/api test:e2e",
    "test:integration": "pnpm --filter @schoolos/api test:integration",
    "check:core-imports": "node scripts/check-core-imports.mjs",
    "check:core-dist": "node scripts/check-core-dist.mjs",
    "db:generate": "pnpm compile:artifacts && pnpm --filter @schoolos/api prisma:generate",
    "db:validate": "pnpm compile:artifacts && pnpm --filter @schoolos/api exec prisma validate --schema prisma/schema.prisma",
    "db:migrate": "pnpm --filter @schoolos/api db:migrate",
    "db:seed": "pnpm --filter @schoolos/api db:seed",
    "db:seed:e2e:m1-reminders": "pnpm --filter @schoolos/api db:seed:e2e:m1-reminders",
    "db:seed:e2e:m1-waitlist": "pnpm --filter @schoolos/api db:seed:e2e:m1-waitlist",
    "db:seed:e2e:m1-assessment": "pnpm --filter @schoolos/api db:seed:e2e:m1-assessment",
    "db:seed:e2e:m3-collection": "pnpm --filter @schoolos/api db:seed:e2e:m3-collection",
    "db:seed:e2e:m3-payment-gateway": "pnpm --filter @schoolos/api db:seed:e2e:m3-payment-gateway",
    "db:seed:e2e:m4-report-card": "pnpm --filter @schoolos/api db:seed:e2e:m4-report-card",
    "db:seed:e2e:m0-account-security": "pnpm --filter @schoolos/api db:seed:e2e:m0-account-security",
    "db:seed:e2e:m0-platform": "pnpm --filter @schoolos/api db:seed:e2e:m0-platform",
    "db:seed:e2e:stage3-learning-improvement": "pnpm --filter @schoolos/api db:seed:e2e:stage3-learning-improvement",
    "db:seed:e2e:stage4-institutional-improvement": "pnpm --filter @schoolos/api db:seed:e2e:stage4-institutional-improvement",
    "db:clean:e2e-notices": "pnpm --filter @schoolos/api db:clean:e2e-notices",
    "db:clean:e2e-academics": "pnpm --filter @schoolos/api db:clean:e2e-academics",
    "db:clean:e2e": "pnpm --filter @schoolos/api db:clean:e2e",
    "db:seed:platform": "pnpm --filter @schoolos/api db:seed:platform",
    "provision:pilot-rehearsal": "node scripts/provision-pilot-rehearsal.mjs",
    "seed:pilot-rehearsal-personas": "pnpm --filter @schoolos/api db:seed:pilot-rehearsal-personas",
    "verify:pilot-entitlements": "node scripts/verify-pilot-entitlements.mjs",
    "verify:m1-admissions": "node scripts/verify-m1-admissions-local.mjs",
    "verify:m2-attendance": "node scripts/verify-m2-attendance-local.mjs",
    "verify:m15-notices": "node scripts/verify-m15-notices-local.mjs",
    "verify:m6-homework": "node scripts/verify-m6-homework-local.mjs",
    "verify:m5-activity": "node scripts/verify-m5-activity-local.mjs",
    "verify:m3-fees": "node scripts/verify-m3-fees-local.mjs",
    "verify:m4-academics": "node scripts/verify-m4-academics-local.mjs",
    "verify:m7-hr": "node scripts/verify-m7-hr-local.mjs",
    "verify:slice4-dashboard-persona": "node scripts/verify-slice4-dashboard-persona-local.mjs",
    "verify:m8-library": "node scripts/verify-m8-library-local.mjs",
    "verify:m9-transport": "node scripts/verify-m9-transport-local.mjs",
    "verify:m10-canteen": "node scripts/verify-m10-canteen-local.mjs",
    "verify:m11-accounting": "node scripts/verify-m11-accounting-local.mjs",
    "mock:payment-gateway": "node scripts/mock-payment-gateway-local.mjs",
    "smoke:pilot:rehearsal": "node scripts/smoke-pilot-rehearsal.mjs",
    "db:seed:geography": "pnpm --filter @schoolos/api db:seed:geography",
    "db:seed:performance": "pnpm --filter @schoolos/api db:seed:performance",
    "test:web:e2e": "pnpm --filter @schoolos/web test:e2e; status=$?; pnpm db:clean:e2e || true; exit $status",
    "verify:env:deploy": "node scripts/check-deploy-env.mjs",
    "verify:env:staging": "DEPLOY_ENV=staging NODE_ENV=production node scripts/check-deploy-env.mjs",
    "verify:env:production": "DEPLOY_ENV=production NODE_ENV=production node scripts/check-deploy-env.mjs",
    "verify:tracked-artifacts": "node scripts/check-tracked-artifacts.mjs",
    "verify:openapi": "node scripts/check-openapi-gate.mjs",
    "verify:deploy:core": "pnpm compile:artifacts && pnpm verify:env:deploy && pnpm verify:tracked-artifacts && pnpm db:generate && pnpm db:validate && pnpm verify:openapi && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build",
    "verify:deploy": "pnpm verify:deploy:core && pnpm test:web:e2e",
    "verify:production": "pnpm verify:deploy",
    "smoke:pilot": "node scripts/smoke-runner-local.mjs pilot",
    "smoke:core": "node scripts/smoke-runner-local.mjs core",
    "smoke:platform": "node scripts/smoke-runner-local.mjs platform",
    "verify:m0-platform": "node scripts/smoke-runner-local.mjs platform",
    "smoke:service-requests": "node scripts/verify-service-requests-local.mjs",
    "smoke:parent-actions": "node scripts/verify-parent-action-centre-local.mjs",
    "smoke:stage2": "node scripts/verify-stage2-operational-control-local.mjs",
    "smoke:stage3": "node scripts/verify-stage3-learning-improvement-local.mjs",
    "smoke:stage4": "node scripts/verify-stage4-institutional-improvement-local.mjs",
    "smoke:learning": "node scripts/smoke-runner-local.mjs learning",
    "smoke:full": "node scripts/smoke-runner-local.mjs full",
    "smoke:phase1": "pnpm smoke:pilot",
    "backup:local": "node scripts/backup-schoolos.mjs",
    "restore:local": "node scripts/restore-schoolos.mjs",
    "rehearse:backup-restore:local": "node scripts/rehearse-backup-restore-local.mjs",
    "staging:deploy:local": "node scripts/staging-deploy-local.mjs",
    "staging:verify:def": "node scripts/verify-def-staging.mjs",
    "staging:verify:gates": "node scripts/verify-staging-gates.mjs",
    "staging:health": "node scripts/check-staging-health.mjs",
    "staging:wave:local": "node scripts/staging-deploy-local.mjs && node scripts/verify-staging-gates.mjs",
    "staging:api:local": "node scripts/start-staging-api-local.mjs",
    "ga:verify:wave0": "node scripts/ga-program-verify.mjs wave0",
    "ga:verify:wave1": "node scripts/ga-program-verify.mjs wave1",
    "ga:verify:wave2": "node scripts/ga-program-verify.mjs wave2",
    "ga:verify:wave3": "node scripts/ga-program-verify.mjs wave3",
    "ga:verify:wave4": "node scripts/ga-program-verify.mjs wave4",
    "ga:verify:wave5": "node scripts/ga-program-verify.mjs wave5",
    "ga:verify:wave6": "node scripts/ga-program-verify.mjs wave6"
  }
}
