# Local staging simulation against docker-compose.staging.yml postgres/redis.
# Used by `pnpm staging:deploy:local` — not for committed secrets.
NODE_ENV=development
DEPLOY_ENV=local-staging
ALLOW_PROD_BOOT=true
PORT=4000

DATABASE_URL=postgresql://schoolos:password123@localhost:5434/schoolos_staging?schema=public
REDIS_HOST=localhost
REDIS_PORT=6380
RATE_LIMIT_ENABLED=true
TRUST_PROXY=false

JWT_SECRET=local-staging-jwt-secret-32chars-minimum!!
JWT_CHALLENGE_SECRET=local-staging-challenge-secret-32chars!!
TOKEN_HASH_PEPPER=local-staging-token-pepper-32chars-min!!
MEDICAL_ENCRYPTION_KEY=local-staging-medical-key-32chars-min!!
JWT_ISSUER=schoolos-local-staging
JWT_AUDIENCE_WEB=schoolos-web-local-staging
JWT_AUDIENCE_MOBILE=schoolos-mobile-local-staging

FRONTEND_ORIGIN=http://localhost:3000
PASSWORD_RESET_APP_URL=http://localhost:3000/reset-password
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

EMAIL_DELIVERY_MODE=log
PUSH_PROVIDER_MODE=disabled
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=storage
