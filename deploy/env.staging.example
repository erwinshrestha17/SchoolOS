# Staging / production deploy secrets template.
# Copy to a secure host path (never commit filled values) and point DEPLOY_ENV_FILE at it.
NODE_ENV=production
DEPLOY_ENV=staging
ALLOW_PROD_BOOT=true
PORT=4000

DATABASE_URL=postgresql://schoolos:replace-with-strong-password@postgres:5432/schoolos_staging?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
RATE_LIMIT_ENABLED=true
TRUST_PROXY=true

JWT_SECRET=replace-with-32-plus-character-random-secret
JWT_CHALLENGE_SECRET=replace-with-second-32-plus-character-random-secret
TOKEN_HASH_PEPPER=replace-with-third-32-plus-character-random-secret
MEDICAL_ENCRYPTION_KEY=replace-with-fourth-32-plus-character-random-secret
JWT_ISSUER=schoolos-staging
JWT_AUDIENCE_WEB=schoolos-web-staging
JWT_AUDIENCE_MOBILE=schoolos-mobile-staging
JWT_ACCESS_TTL=15m
JWT_CHALLENGE_TTL=10m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

FRONTEND_ORIGIN=https://staging.schoolos.example
PASSWORD_RESET_APP_URL=https://staging.schoolos.example/reset-password
NEXT_PUBLIC_API_BASE_URL=https://api-staging.schoolos.example/api/v1

EMAIL_DELIVERY_MODE=log
PUSH_PROVIDER_MODE=disabled
PUSH_PROVIDER_ENABLED=false
PUSH_PROVIDER_READY=false

STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=storage
LOCAL_STORAGE_PUBLIC_BASE_URL=/storage
STORAGE_SIGNING_SECRET=replace-with-storage-signing-secret

COOKIE_SAME_SITE=lax
ACCESS_COOKIE_NAME=school_os_access_token
REFRESH_COOKIE_NAME=school_os_refresh_token
