model SalaryStructure {
  id            String                @id @default(uuid())
  tenantId      String
  staffId       String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  basicSalary   Decimal               @db.Decimal(12, 2)
  allowances    Decimal               @default(0) @db.Decimal(12, 2)
  deductions    Decimal               @default(0) @db.Decimal(12, 2)
  pfEnabled     Boolean               @default(false)
  tdsEnabled    Boolean               @default(false)
  paymentMethod PaymentMethod         @default(BANK)
  bankAccount   String?
  bankName      String?
  status        SalaryStructureStatus @default(DRAFT)
  notes         String?
  activatedAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staff        Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  components   SalaryComponent[]
  payrollLines PayrollLine[]

  @@index([tenantId, staffId, status])
  @@index([tenantId, effectiveFrom, effectiveTo])
}

model SalaryComponent {
  id                String              @id @default(uuid())
  tenantId          String
  salaryStructureId String
  name              String
  componentType     SalaryComponentType
  amount            Decimal             @db.Decimal(12, 2)
  taxable           Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@index([tenantId, salaryStructureId])
}

model PayrollRun {
  id                         String           @id @default(uuid())
  tenantId                   String
  fiscalYearId               String?
  periodMonth                Int
  periodYear                 Int
  revision                   Int              @default(1)
  predecessorRunId           String?          @unique
  // Phase 7.9: authoritative period bounds, always set. For runs created from
  // 7.9 they are the Gregorian bounds of the BS month named by
  // periodYear/periodMonth (see packages/core payroll-period.ts); earlier runs
  // keep the Gregorian-month bounds they were generated with. periodEnd is the
  // last day at 23:59:59.999 UTC (Nepal-local business date semantics).
  periodStart                DateTime
  periodEnd                  DateTime
  // Phase 7.9: the proration divisor this run used and where it came from, so
  // regeneration reproduces it. NULL only for runs created before 7.9.
  divisorDays                Int?
  divisorBasis               PayrollDivisorBasis?
  status                     PayrollRunStatus @default(DRAFT)
  grossAmount                Decimal          @default(0) @db.Decimal(12, 2)
  deductionAmount            Decimal          @default(0) @db.Decimal(12, 2)
  netAmount                  Decimal          @default(0) @db.Decimal(12, 2)
  pfEmployeeAmount           Decimal          @default(0) @db.Decimal(12, 2)
  pfEmployerAmount           Decimal          @default(0) @db.Decimal(12, 2)
  tdsAmount                  Decimal          @default(0) @db.Decimal(12, 2)
  generatedById              String?
  validatedById              String?
  validatedAt                DateTime?
  reviewedById               String?
  reviewedAt                 DateTime?
  approvedById               String?
  finalizedById              String?
  finalizedAt                DateTime?
  approvedSourceFingerprint  String?
  // Phase 7.8: the approved statutory policy version every statutory amount on
  // this run was computed from. NULL only for runs created before 7.8 (their
  // amounts are never recomputed).
  statutoryPolicyVersionId   String?
  postedById                 String?
  paidById                   String?
  approvedAt                 DateTime?
  postedAt                   DateTime?
  paidAt                     DateTime?
  journalEntryId             String?
  disbursementJournalEntryId String?
  notes                      String?
  reversalReason             String?
  reversalAt                 DateTime?
  reversedById               String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fiscalYear FiscalYear?   @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  reversedBy User?         @relation("ReversedPayrollRuns", fields: [reversedById], references: [id], onDelete: SetNull)
  statutoryPolicyVersion NepalHrPolicyVersion? @relation("PayrollRunStatutoryPolicy", fields: [statutoryPolicyVersionId], references: [id], onDelete: Restrict)
  predecessor PayrollRun? @relation("PayrollRevisions", fields: [predecessorRunId], references: [id], onDelete: Restrict)
  replacement PayrollRun? @relation("PayrollRevisions")
  lines      PayrollLine[]
  payslips   Payslip[]
  exceptions PayrollException[]
  holds      PayrollHold[]
  adjustments PayrollAdjustment[] @relation("PayrollAdjustmentTargetRun")
  adjustmentsSourced PayrollAdjustment[] @relation("PayrollAdjustmentSourceRun")
  bankAdviceExports PayrollBankAdviceExport[]

  @@unique([tenantId, periodMonth, periodYear, revision])
  @@index([tenantId, status])
  @@index([statutoryPolicyVersionId])
}

model PayrollException {
  id                   String                   @id @default(uuid())
  tenantId             String
  payrollRunId         String?
  staffId              String?
  periodYear           Int
  periodMonth          Int
  identityKey          String
  code                 PayrollExceptionCode
  severity             PayrollExceptionSeverity
  status               PayrollExceptionStatus  @default(OPEN)
  title                String
  safeMessage          String
  resolutionRoute      String?
  blockedActions       String[]
  detectedAt           DateTime                 @default(now())
  lastDetectedAt       DateTime                 @default(now())
  acknowledgedAt       DateTime?
  acknowledgedById     String?
  acknowledgementReason String?
  resolvedAt           DateTime?
  resolutionReason     String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payrollRun PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staff      Staff?      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([tenantId, identityKey])
  @@index([tenantId, periodYear, periodMonth, status, severity])
  @@index([tenantId, payrollRunId, status])
  @@index([tenantId, staffId, status])
  @@index([tenantId, code, status])
}

model PayrollLine {
  id                String               @id @default(uuid())
  tenantId          String
  payrollRunId      String
  staffId           String
  contractId        String?
  salaryStructureId String?
  // Phase 7.1: the verified employment window this line was computed against.
  employmentId      String?
  employmentFrom    DateTime?
  employmentTo      DateTime?
  // Phase 7.8: per-scheme bases and amounts exactly as computed (no identifiers).
  statutoryBreakdown Json?
  // Phase 7.9: the persisted proration lineage (divisor, employment and salary
  // structure segments, day counts) the amounts were derived from.
  prorationBreakdown Json?
  // Phase 7.9: consumed 7.7 payroll adjustments, already included in
  // grossSalary / deductions respectively (never in a statutory basis other
  // than the policy-defined gross).
  adjustmentEarnings   Decimal            @default(0) @db.Decimal(12, 2)
  adjustmentDeductions Decimal            @default(0) @db.Decimal(12, 2)
  basicSalary       Decimal              @default(0) @db.Decimal(12, 2)
  earnings          Decimal              @default(0) @db.Decimal(12, 2)
  grossSalary       Decimal              @db.Decimal(12, 2)
  allowances        Decimal              @default(0) @db.Decimal(12, 2)
  leaveDeductions   Decimal              @default(0) @db.Decimal(12, 2)
  pfEmployee        Decimal              @default(0) @db.Decimal(12, 2)
  pfEmployer        Decimal              @default(0) @db.Decimal(12, 2)
  tds               Decimal              @default(0) @db.Decimal(12, 2)
  otherDeductions   Decimal              @default(0) @db.Decimal(12, 2)
  deductions        Decimal              @default(0) @db.Decimal(12, 2)
  netSalary         Decimal              @db.Decimal(12, 2)
  paidDays          Decimal              @default(0) @db.Decimal(8, 2)
  unpaidDays        Decimal              @default(0) @db.Decimal(8, 2)
  attendanceDays    Int                  @default(0)
  workingDays       Int                  @default(0)
  paymentStatus     PayrollPaymentStatus @default(UNPAID)
  status            PayrollLineStatus    @default(DRAFT)
  createdAt         DateTime             @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payrollRun      PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staff           Staff            @relation(fields: [staffId], references: [id], onDelete: Restrict)
  contract        StaffContract?   @relation(fields: [contractId], references: [id], onDelete: SetNull)
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  employment      StaffEmployment? @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  payslip         Payslip?

  @@unique([tenantId, payrollRunId, staffId])
  @@index([employmentId])
}

model Payslip {
  id              String               @id @default(uuid())
  tenantId        String
  payrollRunId    String
  payrollLineId   String               @unique
  staffId         String
  payslipNumber   String
  status          PayslipStatus        @default(DRAFT)
  grossSalary     Decimal              @db.Decimal(12, 2)
  deductionAmount Decimal              @db.Decimal(12, 2)
  pfEmployee      Decimal              @default(0) @db.Decimal(12, 2)
  pfEmployer      Decimal              @default(0) @db.Decimal(12, 2)
  tds             Decimal              @default(0) @db.Decimal(12, 2)
  netSalary       Decimal              @db.Decimal(12, 2)
  paymentStatus   PayrollPaymentStatus @default(UNPAID)
  generatedAt     DateTime             @default(now())
  issuedAt        DateTime?
  createdAt       DateTime             @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payrollRun  PayrollRun  @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  payrollLine PayrollLine @relation(fields: [payrollLineId], references: [id], onDelete: Cascade)
  staff       Staff       @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([tenantId, payslipNumber])
}

// Phase 7.8: which statutory retirement scheme a staff member belongs to and
// under what identifier, for an effective window. Rates never live here; they
// come from an approved NepalHrPolicyVersion of kind STATUTORY_SCHEME_TAX.
// A staff member belongs to at most one scheme at any instant (database
// EXCLUDE). Identifiers are protected under hr:tax:*.
model StaffStatutoryMembership {
  id               String          @id @default(uuid())
  tenantId         String
  staffId          String
  scheme           StatutoryScheme
  memberIdentifier String?
  effectiveFrom    DateTime        @db.Date
  effectiveTo      DateTime?       @db.Date
  createdById      String
  endedById        String?
  endReason        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  staff     Staff  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  createdBy User   @relation("StaffStatutoryMembershipCreator", fields: [createdById], references: [id], onDelete: Restrict)
  endedBy   User?  @relation("StaffStatutoryMembershipEnder", fields: [endedById], references: [id], onDelete: Restrict)

  @@index([tenantId, staffId, effectiveFrom])
}

// Phase 7.9: a reason-bound payment hold on one staff member in one payroll
// run. The calculation is kept; the hold only withholds payment (bank advice
// and mark-paid). History is append-only: a hold is released, never deleted,
// and the releaser must differ from the person who placed it.
model PayrollHold {
  id            String            @id @default(uuid())
  tenantId      String
  payrollRunId  String
  staffId       String
  status        PayrollHoldStatus @default(ACTIVE)
  reason        String
  createdById   String
  createdAt     DateTime          @default(now())
  releasedById  String?
  releasedAt    DateTime?
  releaseReason String?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  createdBy  User       @relation("PayrollHoldCreator", fields: [createdById], references: [id], onDelete: Restrict)
  releasedBy User?      @relation("PayrollHoldReleaser", fields: [releasedById], references: [id], onDelete: Restrict)

  @@index([tenantId, payrollRunId, status])
  @@index([tenantId, staffId])
}

// Phase 7.9: consumption of one approved-but-locked 7.7 attendance correction
// (StaffAttendanceCorrection.status = PENDING_PAYROLL_ADJUSTMENT) by exactly one
// payroll run. The correction itself stays immutable; this row is the lineage.
// A correction can be APPLIED to at most one run at a time (partial unique
// index); the row is RELEASED when its run is regenerated, voided or cancelled.
model PayrollAdjustment {
  id                   String                  @id @default(uuid())
  tenantId             String
  payrollRunId         String
  staffId              String
  correctionId         String
  sourcePayrollRunId   String
  attendanceDate       DateTime                @db.Date
  kind                 PayrollAdjustmentKind
  status               PayrollAdjustmentStatus @default(APPLIED)
  // Signed paid-day change the correction causes (+ arrears, - recovery).
  deltaDays            Decimal                 @db.Decimal(8, 2)
  // Pricing basis taken from the source run's line, persisted for audit.
  dailyRate            Decimal                 @db.Decimal(14, 4)
  amount               Decimal                 @db.Decimal(12, 2)
  pricing              Json
  createdById          String
  createdAt            DateTime                @default(now())
  releasedAt           DateTime?
  releaseReason        String?

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payrollRun       PayrollRun                 @relation("PayrollAdjustmentTargetRun", fields: [payrollRunId], references: [id], onDelete: Restrict)
  sourcePayrollRun PayrollRun                 @relation("PayrollAdjustmentSourceRun", fields: [sourcePayrollRunId], references: [id], onDelete: Restrict)
  staff            Staff                      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  correction       StaffAttendanceCorrection  @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  createdBy        User                       @relation("PayrollAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, payrollRunId, status])
  @@index([tenantId, correctionId])
}

// Phase 7.9: append-only record of every bank payment advice export, with the
// snapshot identity (approved source fingerprint + content hash) it was built
// from. The first export is sequence 1; any later one needs a stated reason.
model PayrollBankAdviceExport {
  id                String   @id @default(uuid())
  tenantId          String
  payrollRunId      String
  sequence          Int
  exportedById      String
  exportedAt        DateTime @default(now())
  lineCount         Int
  heldLineCount     Int
  totalAmount       Decimal  @db.Decimal(14, 2)
  sourceFingerprint String
  contentSha256     String
  reExportReason    String?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  exportedBy User       @relation("PayrollBankAdviceExporter", fields: [exportedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, payrollRunId, sequence])
}
