NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Staging/production must use the HTTPS API origin and include /api/v1.
# Example:
# NEXT_PUBLIC_API_BASE_URL=https://api-staging.schoolos.example/api/v1

# Public marketing launch configuration. Set approved values before building
# the production site; missing values keep robots.txt closed and public pages
# noindexed. The final Privacy Policy and Terms text must be legally reviewed.
# SCHOOLOS_PUBLIC_SITE_URL=https://your-production-domain.example/
# SCHOOLOS_LEGAL_OPERATOR_NAME=Approved legal operator
# SCHOOLOS_PRIVACY_CONTACT_EMAIL=privacy@your-production-domain.example
# SCHOOLOS_PRIVACY_RETENTION=Approved demo-request retention and deletion rule
# SCHOOLOS_DATA_RECIPIENTS=Approved data recipients and processors disclosure
# SCHOOLOS_COOKIE_AND_LOG_NOTICE=Approved cookie, session, and hosting-log notice
# SCHOOLOS_TERMS_GOVERNING_LAW=Approved governing-law and dispute process
# SCHOOLOS_LEGAL_EFFECTIVE_DATE=Approved effective date
# SCHOOLOS_LEGAL_POLICY_APPROVED=true
# NEXT_PUBLIC_API_BASE_URL must also be HTTPS before public indexing opens.
